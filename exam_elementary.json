[
  {
    "Mavzular": "Card A",
    "Mavzular nomi": "Travelling",
    "Qism": "Part 1",
    "Sovollar": "1. Do you like travelling?",
    "Sovollar (UZ)": "Siz sayohat qilishni yoqtirasizmi?",
    "FullAnswer_EN": "Yes, I really like travelling to new places.",
    "FullAnswer_UZ": "Ha, menga yangi joylarga sayohat qilish juda yoqadi.",
    "Reason_EN": "Because it is very interesting to see different cities and nature.",
    "Reason_UZ": "Chunki turli xil shaharlar va tabiatni ko'rish juda qiziqarli.",
    "Example_EN": "For example, last summer I visited Samarkand and saw many historical buildings.",
    "Example_UZ": "Masalan, o'tgan yozda men Samarqandga bordim va ko'plab tarixiy binolarni ko'rdim.",
    "ExtraInfo_EN": "And also I like taking many photos during my trips.",
    "ExtraInfo_UZ": "Shuningdek, sayohatlarim davomida ko'plab rasmga tushishni yoqtiraman."
  },
  {
    "Mavzular": "Card A",
    "Mavzular nomi": "Travelling",
    "Qism": "Part 1",
    "Sovollar": "2. Do you always travel alone or with your family?",
    "Sovollar (UZ)": "Siz doim yolg‘iz yoki oilangiz bilan sayohat qilasizmi?",
    "FullAnswer_EN": "I usually travel with my family or friends.",
    "FullAnswer_UZ": "Men odatda oilam yoki do'stlarim bilan sayohat qilaman.",
    "Reason_EN": "Because spending time with people I love makes me happy.",
    "Reason_UZ": "Chunki o'zim yaxshi ko'rgan insonlar bilan vaqt o'tkazish meni xursand qiladi.",
    "Example_EN": "For example, we often go to the mountains together on weekends.",
    "Example_UZ": "Masalan, biz dam olish kunlari ko'pincha birgalikda tog'ga boramiz.",
    "ExtraInfo_EN": "And also it is safer to travel in a group.",
    "ExtraInfo_UZ": "Shuningdek, guruh bo'lib sayohat qilish xavfsizroq."
  },
  {
    "Mavzular": "Card A",
    "Mavzular nomi": "Travelling",
    "Qism": "Part 1",
    "Sovollar": "3. How often do you travel?",
    "Sovollar (UZ)": "Qanchalik tez-tez sayohat qilasiz?",
    "FullAnswer_EN": "I travel about two or three times a year.",
    "FullAnswer_UZ": "Men yiliga taxminan ikki yoki uch marta sayohat qilaman.",
    "Reason_EN": "Because I have holidays at my school and I use this time.",
    "Reason_UZ": "Chunki mening o'qishimda ta'tillar bor va men bu vaqtdan foydalanaman.",
    "Example_EN": "For example, I usually go on a trip during my summer vacation.",
    "Example_UZ": "Masalan, odatda yozgi ta'tilim paytida sayohatga chiqaman.",
    "ExtraInfo_EN": "And also I want to travel more in the future.",
    "ExtraInfo_UZ": "Shuningdek, kelajakda ko'proq sayohat qilishni xohlayman."
  },
  {
    "Mavzular": "Card A",
    "Mavzular nomi": "Travelling",
    "Qism": "Part 1",
    "Sovollar": "4. How do you travel?",
    "Sovollar (UZ)": "Siz qanday sayohat qilasiz?",
    "FullAnswer_EN": "I prefer to travel by car or by train.",
    "FullAnswer_UZ": "Men mashina yoki poezdda sayohat qilishni afzal ko'raman.",
    "Reason_EN": "Because these transports are very comfortable and fast.",
    "Reason_UZ": "Chunki ushbu transportlar juda qulay va tezkor.",
    "Example_EN": "For example, when we go to Tashkent we take the Afrosiyob train.",
    "Example_UZ": "Masalan, Toshkentga borganimizda Afrosiyob poezdiga chiqamiz.",
    "ExtraInfo_EN": "And also I like looking out the window at the view.",
    "ExtraInfo_UZ": "Shuningdek, derazadan manzarani tomosha qilishni yoqtiraman."
  },
  {
    "Mavzular": "Card A",
    "Mavzular nomi": "Travelling",
    "Qism": "Part 2",
    "Sovollar": "1. What kind of transport do people use to travel?",
    "Sovollar (UZ)": "Odamlar sayohat qilish uchun qanday transportdan foydalanadi?",
    "FullAnswer_EN": "People use many types of transport like buses, cars and planes.",
    "FullAnswer_UZ": "Odamlar avtobus, mashina va samolyot kabi ko'plab transport turlaridan foydalanishadi.",
    "Reason_EN": "Because it depends on where they want to go and their money.",
    "Reason_UZ": "Chunki bu ularning qayerga borishni xohlashiga va pullariga bog'liq.",
    "Example_EN": "For example, tourists take an airplane to travel to other countries.",
    "Example_UZ": "Masalan, sayyohlar boshqa davlatlarga borish uchun samolyotdan foydalanishadi.",
    "ExtraInfo_EN": "And also some people like walking or riding a bike.",
    "ExtraInfo_UZ": "Shuningdek, ba'zi odamlar piyoda yurishni yoki velosiped haydashni yoqtirishadi."
  },
  {
    "Mavzular": "Card A",
    "Mavzular nomi": "Travelling",
    "Qism": "Part 2",
    "Sovollar": "2. Why do people want to travel?",
    "Sovollar (UZ)": "Odamlar nima uchun sayohat qilishni xohlashadi?",
    "FullAnswer_EN": "People want to travel to relax and see the world.",
    "FullAnswer_UZ": "Odamlar dam olish va dunyoni ko'rish uchun sayohat qilishni xohlashadi.",
    "Reason_EN": "Because a change of place helps them to reduce stress.",
    "Reason_UZ": "Chunki joyning o'zgarishi ularga stressni kamaytirishga yordam beradi.",
    "Example_EN": "For example, families go to the seaside to have a good time together.",
    "Example_UZ": "Masalan, oilalar birgalikda vaqtni maroqli o'tkazish uchun dengiz bo'yiga borishadi.",
    "ExtraInfo_EN": "And also they learn about different cultures.",
    "ExtraInfo_UZ": "Shuningdek, ular turli madaniyatlar haqida o'rganishadi."
  },
  {
    "Mavzular": "Card A",
    "Mavzular nomi": "Travelling",
    "Qism": "Part 2",
    "Sovollar": "3. Describe your favourite hotel.",
    "Sovollar (UZ)": "Sevimli mehmonxonangizni tasvirlab bering.",
    "FullAnswer_EN": "My favourite hotel is a modern building with many rooms.",
    "FullAnswer_UZ": "Mening sevimli mehmonxonam ko'plab xonalarga ega zamonaviy binodir.",
    "Reason_EN": "Because the service is very good and the rooms are clean.",
    "Reason_UZ": "Chunki xizmat ko'rsatish juda yaxshi va xonalar toza.",
    "Example_EN": "For example, it has a large swimming pool and a big garden.",
    "Example_UZ": "Masalan, uning katta suzish havzasi va katta bog'i bor.",
    "ExtraInfo_EN": "And also the breakfast there is very delicious.",
    "ExtraInfo_UZ": "Shuningdek, u yerdagi nonushta juda mazali."
  },
  {
  "Mavzular": "Card A",
  "Mavzular nomi": "Travelling",
  "Qism": "Part 2",
  "Sovollar": "4. Speak about your last travel.",
  "Sovollar (UZ)": "Oxirgi sayohatingiz haqida gapiring.",
  "FullAnswer_EN": "My last trip was to Bukhara with my friends.",
  "FullAnswer_UZ": "Oxirgi sayohatim do'stlarim bilan Buxoroga bo'lgan.",
  "Reason_EN": "Because we wanted to see the old city.",
  "Reason_UZ": "Chunki biz eski shaharni ko'rishni xohladik.",
  "Example_EN": "For example, we visited a big old building and took photos.",
  "Example_UZ": "Masalan, biz katta eski binoga bordik va rasmga tushdik.",
  "ExtraInfo_EN": "And also we ate very good food there.",
  "ExtraInfo_UZ": "Shuningdek, u yerda juda yaxshi ovqat yedik."
},
